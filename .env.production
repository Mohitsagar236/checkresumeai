# Production Environment Variables for Vercel Deployment
# Add these in Vercel Dashboard → Project → Settings → Environment Variables
# DO NOT commit real keys here — use Vercel dashboard for secrets

# AI API Keys (keep on backend only — these VITE_ keys expose to browser)
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_GROQ_API_KEY=your-groq-api-key-here
VITE_TOGETHER_API_KEY=your-together-api-key-here

# Supabase Configuration (anon key is safe to expose)
VITE_SUPABASE_URL=https://rvmvahwyfptyhchlvtvr.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API URL — set this to your Railway/Render backend URL after deploying
VITE_API_BASE_URL=https://your-backend.railway.app/api/v1

# Feature Flags
VITE_USE_MOCK_API=false
VITE_ENABLE_REAL_TIME_ANALYSIS=true
VITE_ENABLE_PREMIUM_FEATURES=true
