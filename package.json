{
    "name": "checkresumeai",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --max-http-header-size=32768 ./node_modules/vite/bin/vite.js",
        "dev:safe": "cross-env NODE_OPTIONS=\"--max-http-header-size=32768\" vite",
        "prebuild": "",
        "build": "node ./node_modules/vite/bin/vite.js build --mode production",
        "build:frontend": "node ./node_modules/vite/bin/vite.js build --mode production",
        "build:backend": "cd backend && npm install --include=dev && npm run build",
        "build:optimized": "GENERATE_SOURCEMAP=false DISABLE_ESLINT_PLUGIN=true node ./node_modules/vite/bin/vite.js build --mode production",
        "simple-vercel-build": "node scripts/simple-vercel-build.js",
        "render-build": "node scripts/render-build.js",
        "ultra-fast-build": "node scripts/ultra-fast-build.js",
        "setup-pdf-worker": "echo 'Setting up PDF worker files...'",
        "vercel-build": "node ./node_modules/vite/bin/vite.js build --mode production --emptyOutDir",
        "start": "cd backend && node dist/server.js",
        "health-check": "node scripts/health-check.js",
        "verify-build": "node scripts/verify-build.js"
    },
    "devDependencies": {
        "cross-env": "^7.0.3"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-tabs": "^1.1.12",
        "@supabase/supabase-js": "^2.50.0",
        "@tailwindcss/forms": "^0.5.9",
        "@tailwindcss/postcss": "^4.1.10",
        "@tanstack/react-query": "^5.80.7",
        "@types/react": "18.3.12",
        "@types/react-dom": "18.3.1",
        "@vitejs/plugin-react": "^4.5.2",
        "autoprefixer": "^10.4.21",
        "axios": "^1.10.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.18.1",
        "html2canvas": "^1.4.1",
        "jspdf": "^3.0.1",
        "lodash": "^4.17.21",
        "lucide-react": "^0.516.0",
        "pdfjs-dist": "^5.3.31",
        "postcss": "^8.5.6",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-helmet-async": "^2.0.5",
        "react-router-dom": "^7.6.2",
        "react-to-print": "^3.1.1",
        "recharts": "^2.15.3",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^3.4.17",
        "vite": "^6.3.5",
        "zustand": "^5.0.6"
    },
    "optionalDependencies": {
        "firebase": "^10.14.1"
    }
}
